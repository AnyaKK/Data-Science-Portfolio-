# R session and IDE state
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Quarto execution cache and transient support directories
/.quarto/
/*_cache/
/*_files/

# Private/source data must never be committed
/data/*
!/data/README.md
/analysis_outputs/calibrated_data_corrected.csv
/analysis_outputs/cases_by_path.csv
/analysis_outputs/case_exclusions_*.csv
/results/private/
/results/tables/calibrated_data_corrected.csv
/results/tables/cases_by_path.csv
/results/tables/case_exclusions*.csv

# Supplied assessment/manuscript artifacts stay outside the public project
*.docx
*.ipynb

# System/editor artifacts
.DS_Store
Thumbs.db
*.tmp
*.log

# Quarto Jupyter intermediates (also added automatically by some Quarto builds)
**/*.quarto_ipynb
